<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Interop.JS.Shadcn.Cn.fecs</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.2</Version>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Overrides\*.js" />
    <EmbeddedResource Include="Overrides\manifest.json" />
    <EmbeddedResource Include="RuntimeAssets\*.js"
                      LogicalName="$(AssemblyName).RuntimeAssets.%(Filename)%(Extension)" />
    <ProjectReference Include="..\Interop.JS.Shadcn.Cn\Interop.JS.Shadcn.Cn.csproj" />

    <ProjectReference Include="..\..\..\Compiler\RuntimeOverrides\Abstractions\FrontEndCSharp.RuntimeOverrides.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Import Project="..\..\..\Compiler\RuntimeOverrides\Packaging\JavaScriptPackageCompanion.targets" />

</Project>
