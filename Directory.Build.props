<Project>
  <PropertyGroup>
    <!-- VSIX projects use the normalized repository root to import VSSDK.BuildTools.props. -->
    <_FrontEndCSharpRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</_FrontEndCSharpRepositoryRoot>

    <!-- Keep project-local intermediate subtrees out of SDK default item globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\**\obj\**</DefaultItemExcludes>

    <!-- Shared public NuGet metadata. Package projects may override authors and descriptions. -->
    <Authors Condition="'$(Authors)' == ''">drewdelano</Authors>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance Condition="'$(PackageRequireLicenseAcceptance)' == ''">false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/drewdelano/FrontEndCSharp</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/drewdelano/FrontEndCSharp</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
