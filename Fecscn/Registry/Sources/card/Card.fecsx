using Interop.JS.React;
namespace Fecscn.Components.UI;

public static ReactNode Default(CardProps props, ReactNode[] children) =>
    <div className={ClassNames.Merge("group/card flex flex-col gap-(--card-spacing) overflow-hidden rounded-xl bg-card py-(--card-spacing) text-sm text-card-foreground ring-1 ring-foreground/10 [--card-spacing:--spacing(4)] has-[>img:first-child]:pt-0 *:[img:first-child]:rounded-t-xl *:[img:last-child]:rounded-b-xl", props.Size == CardSize.Small ? "[--card-spacing:--spacing(3)]" : null, props.ClassName)}>
        {children}
    </div>;

public static ReactNode Header(CardPartProps props, ReactNode[] children) =>
    <div className={ClassNames.Merge("group/card-header @container/card-header grid auto-rows-min items-start gap-1 rounded-t-xl px-(--card-spacing) [.border-b]:pb-(--card-spacing)", props.ClassName)}>{children}</div>;

public static ReactNode Title(CardPartProps props, ReactNode[] children) =>
    <div className={ClassNames.Merge("cn-font-heading text-base leading-snug font-medium group-data-[size=sm]/card:text-sm", props.ClassName)}>{children}</div>;

public static ReactNode Description(CardPartProps props, ReactNode[] children) =>
    <div className={ClassNames.Merge("text-sm text-muted-foreground", props.ClassName)}>{children}</div>;

public static ReactNode Action(CardPartProps props, ReactNode[] children) =>
    <div className={ClassNames.Merge("col-start-2 row-span-2 row-start-1 self-start justify-self-end", props.ClassName)}>{children}</div>;

public static ReactNode Content(CardPartProps props, ReactNode[] children) =>
    <div className={ClassNames.Merge("px-(--card-spacing)", props.ClassName)}>{children}</div>;

public static ReactNode Footer(CardPartProps props, ReactNode[] children) =>
    <div className={ClassNames.Merge("flex items-center rounded-b-xl border-t bg-muted/50 p-(--card-spacing)", props.ClassName)}>{children}</div>;
