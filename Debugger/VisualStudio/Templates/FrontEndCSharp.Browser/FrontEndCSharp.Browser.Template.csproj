      <Culture>1033</Culture>
    </VSTemplate>
    <None Include="Host\**\*" />
    <None Include="Browser\**\*" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <Target Name="RequireVssdkBuildTools"
          BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')">
    <Error Text="Microsoft.VSSDK.BuildTools is not available. Restore and build the containing VSIX project, then build this project again." />
  </Target>

  <Target Name="CreateProjectTemplateArchive" AfterTargets="Build" DependsOnTargets="ZipProjects" />

