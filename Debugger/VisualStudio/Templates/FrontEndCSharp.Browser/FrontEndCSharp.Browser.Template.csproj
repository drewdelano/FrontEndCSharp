    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{D31CD5E7-E480-4178-91BC-CDBC6E363D25}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>FrontEndCSharp.Browser.Template</RootNamespace>
    <AssemblyName>FrontEndCSharp.Browser.Template</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <RestoreProjectStyle>None</RestoreProjectStyle>
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <FileAlignment>512</FileAlignment>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DeployExtension>false</DeployExtension>
    <DeployVSTemplates>false</DeployVSTemplates>
    <CreateVsixContainer>false</CreateVsixContainer>
    <CopyVsixManifestToOutput>false</CopyVsixManifestToOutput>
