  <Commands package="guidFrontEndCSharpPackage">
    <Buttons>
      <Button guid="guidFrontEndCSharpCommandSet" id="DebugWithFrontEndCSharp" priority="0x0350" type="Button">
        <Parent guid="guidVSDebugGroup" id="IDG_EXECUTION" />
        <Strings>
          <ButtonText>Debug with FrontEndCSharp</ButtonText>
          <CommandName>Debug with FrontEndCSharp</CommandName>
          <CanonicalName>FrontEndCSharp.Debug</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidFrontEndCSharpCommandSet" id="ApplyFrontEndCSharpCodeChanges" priority="0x0C00" type="Button">
        <Parent guid="guidVSDebugGroup" id="IDG_EXECUTION" />
        <Strings>
          <ButtonText>FrontEndCSharp: Apply Code Changes</ButtonText>
          <CommandName>FrontEndCSharp: Apply Code Changes</CommandName>
          <CanonicalName>FrontEndCSharp.ApplyCodeChanges</CanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidFrontEndCSharpCommandSet" id="DebugWithFrontEndCSharp"
                editor="guidVSStd97" key1="VK_F5" mod1="CONTROL ALT" />
    <KeyBinding guid="guidFrontEndCSharpCommandSet" id="ApplyFrontEndCSharpCodeChanges"
                editor="guidVSStd97" key1="VK_F10" mod1="CONTROL ALT" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidVSDebugGroup" value="{c9dd4a58-47fb-11d2-83e7-00c04f9902c1}" />
    <GuidSymbol name="guidFrontEndCSharpPackage" value="{cfcb81f4-801e-4f6b-a582-3dcd42ca0218}" />
