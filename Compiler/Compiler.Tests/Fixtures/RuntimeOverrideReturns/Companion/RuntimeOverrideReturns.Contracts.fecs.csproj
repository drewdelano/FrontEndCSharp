<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RuntimeOverrideReturns.Contracts.fecs</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Overrides\*.js" />
    <EmbeddedResource Include="Overrides\manifest.json" />
    <EmbeddedResource Include="RuntimeAssets\*.js"
                      LogicalName="$(AssemblyName).RuntimeAssets.%(Filename)%(Extension)" />
    <ProjectReference Include="..\Contracts\RuntimeOverrideReturns.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\RuntimeOverrides\Abstractions\FrontEndCSharp.RuntimeOverrides.csproj" />
  </ItemGroup>
</Project>
