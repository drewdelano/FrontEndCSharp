    <PackageReference Include="FrontEndCSharp.Overrides.Interop.JS.Browser.fecs" Version="1.0.0" />
    <PackageReference Include="FrontEndCSharp.Overrides.Interop.JS.React" Version="19.3.1" />
    <PackageReference Include="FrontEndCSharp.Overrides.Interop.JS.React.fecs" Version="19.3.1" />
    <PackageReference Include="FrontEndCSharp.Overrides.System.Private.CoreLib.fecs" Version="1.0.0" />
  </ItemGroup>

</Project>
