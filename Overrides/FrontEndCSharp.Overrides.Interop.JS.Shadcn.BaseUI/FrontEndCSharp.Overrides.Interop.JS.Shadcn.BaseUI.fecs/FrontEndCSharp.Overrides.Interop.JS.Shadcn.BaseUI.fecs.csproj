<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FrontEndCSharp.Overrides.Interop.JS.Shadcn.BaseUI.fecs</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.9.0</Version>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Overrides\*.js" />
    <EmbeddedResource Include="Overrides\manifest.json" />
    <EmbeddedResource Include="RuntimeAssets\*.js"
                      LogicalName="$(AssemblyName).RuntimeAssets.%(Filename)%(Extension)" />
    <ProjectReference Include="..\FrontEndCSharp.Overrides.Interop.JS.Shadcn.BaseUI\FrontEndCSharp.Overrides.Interop.JS.Shadcn.BaseUI.csproj" />
    <ProjectReference Include="..\..\FrontEndCSharp.Overrides.Interop.JS.React\FrontEndCSharp.Overrides.Interop.JS.React\FrontEndCSharp.Overrides.Interop.JS.React.csproj" />
    <ProjectReference Include="..\..\FrontEndCSharp.Overrides.Interop.JS.React\FrontEndCSharp.Overrides.Interop.JS.React.fecs\FrontEndCSharp.Overrides.Interop.JS.React.fecs.csproj" />
    <ProjectReference Include="..\..\..\Compiler\RuntimeOverrides\Abstractions\FrontEndCSharp.RuntimeOverrides.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Import Project="..\..\..\Compiler\RuntimeOverrides\Packaging\JavaScriptPackageCompanion.targets" />

</Project>
